# Copie este arquivo para .env e preencha os valores reais.
# O .env está no .gitignore e NUNCA deve ser commitado.

# Connection string do MongoDB Atlas
DATABASE_URL="mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/sysvet"

# Secret usado para assinar os tokens JWT.
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
